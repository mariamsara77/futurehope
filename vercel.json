{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "ignoreCommand": "if [ \"$VERCEL_PROJECT_ID\" = \"prj_ZeUj6cXYCoxtqKu3yhrEJueLNvs4\" ] && [ \"$VERCEL_GIT_COMMIT_REF\" = \"larvel-code\" ]; then exit 0; else exit 1; fi",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/build/(.*)",
      "dest": "/public/build/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
